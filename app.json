{
  "expo": {
    "name": "expense",
    "slug": "expense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "expenseapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harsh.expense",
      "infoPlist": {
        "NSMotionUsageDescription": "Enable motion sensors to detect shake gestures and quickly log expenses."
      }
    },
    "android": {
      "package": "com.harsh.expense",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "./plugins/withShakeService"
    ],
    "extra": {
      "eas": {
        "projectId": "cb9c355b-3789-4bc6-a237-797aa669a3c6"
      }
    }
  }
}
